# Copy to .env (Git-ignored). `npm run keygen` fills EXTENSION_KEY.
# Public key that pins the extension ID (the sign-in redirect depends on it).
EXTENSION_KEY=
# OAuth client ID from the Google Cloud project (Web application type, Internal audience).
GOOGLE_CLIENT_ID=
# Optional: account the sign-in screen suggests, e.g. you@yourcompany.com
LOGIN_HINT=
