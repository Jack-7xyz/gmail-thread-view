{
  "manifest_version": 3,
  "name": "Thread View for Gmail",
  "version": "0.1.0",
  "description": "Read Gmail threads as a clean, Slack-style timeline. Read-only.",
  "key": "__EXTENSION_KEY__",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "identity", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://mail.google.com/*", "https://gmail.googleapis.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Thread view (Alt+Shift+T)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T", "mac": "Alt+Shift+T" } }
  }
}
